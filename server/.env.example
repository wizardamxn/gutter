# Copy to .env and fill in.
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/gutter

# Required. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Hosted AI: set a key for each model you want Gutter to offer signed-in users.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional model overrides (defaults live in shared/providers.ts).
OPENAI_MODEL=
ANTHROPIC_MODEL=
GEMINI_MODEL=

# Hosted side questions per user per day.
FREE_DAILY_LIMIT=25

# Lock the API to your published extension id (recommended in production).
EXTENSION_ID=

# Needed to publish selector fixes (PUT /api/config/selectors). Leave empty to disable.
ADMIN_TOKEN=
